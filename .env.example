# Supabase (Configurações do projeto > API no painel do Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca expor no cliente. Usada só em Server Actions de admin (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Rate limiting (Upstash Redis - opcional em desenvolvimento, recomendado em produção)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anti-spam nos formulários públicos (Cloudflare Turnstile - opcional em desenvolvimento)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# E-mails transacionais (Resend - opcional no MVP)
RESEND_API_KEY=

# Vaga em destaque / pagamentos (Mercado Pago - vazio = "Destacar vaga" mostra
# aviso de "não configurado" em vez de quebrar. Ver passo a passo no README.)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
